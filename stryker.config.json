{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts"
  ],
  "reporters": [
    "json",
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "timeoutMS": 120000,
  "concurrency": 8,
  "disableTypeChecks": false,
  "htmlReporter": {
    "fileName": ".stryker-tmp/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "ignorePatterns": [
    "tsconfig.json"
  ],
  "jsonReporter": {
    "fileName": ".stryker-tmp/mutation.json"
  },
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  }
}