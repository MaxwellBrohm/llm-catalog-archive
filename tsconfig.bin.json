{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "removeComments": false,
    "newLine": "lf",
    "outDir": "build/bin",
    "rootDir": "bin"
  },
  "include": [
    "bin/llmcat.ts"
  ]
}