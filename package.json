{
  "name": "llm-catalog-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:site": "tsx src/site-cli.ts",
    "mutate": "stryker run",
    "build:bin": "tsc -p tsconfig.bin.json && cp build/bin/llmcat.js bin/llmcat.mjs",
    "check:bin": "npm run build:bin && git diff --exit-code -- bin/llmcat.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.2",
    "three": "^0.181.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "bin": {
    "llmcat": "bin/llmcat.mjs"
  },
  "files": [
    "bin",
    "src",
    "meta"
  ]
}
